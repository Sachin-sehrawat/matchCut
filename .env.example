POSTGRES_DB=matchcut
POSTGRES_USER=matchcut
POSTGRES_PASSWORD=matchcut
MONGO_USER=matchcut
MONGO_PASSWORD=matchcut
JWT_SECRET=
TMDB_API_KEY=
# Optional: YouTube Data API v3 key, used as a fallback trailer search when
# TMDB has no trailer video on file for a movie. Leave unset to skip it.
YOUTUBE_API_KEY=

# Founder-only manual fallback and backup export — see "Founder tooling" in CLAUDE.md
# DB_DRIVER=sqlite
# BACKUP_WEBHOOK_URL=

# Your domain (e.g. a No-IP hostname), pointed at this host's public IP via
# an A record — required for the `caddy` service to issue a real Let's
# Encrypt certificate. Leave unset to keep using the plain 8080 port.
DOMAIN=
