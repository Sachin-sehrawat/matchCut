DATABASE_URL=postgres://matchcut:matchcut@localhost:5432/matchcut
JWT_SECRET=
TMDB_API_KEY=
PORT=4000

# Optional: if a movie has no trailer on TMDB, fetchTrailerKey falls back to
# searching YouTube directly for one. Needs its own key (YouTube Data API v3,
# separate from the TMDB key) from Google Cloud Console — leave unset to skip
# the fallback (trailer will just stay unavailable for that movie).
YOUTUBE_API_KEY=

# Every movie fetched from TMDB is also archived into this MongoDB collection
# (see src/mongo.js) as an independent, growing dataset — leave unset to
# disable archiving (it's a no-op, not a hard requirement).
MONGODB_URI=mongodb://matchcut:matchcut@localhost:27017/matchcut?authSource=admin

# Founder-only manual fallback (see "Founder tooling" in CLAUDE.md) —
# set DB_DRIVER=sqlite to run against a local SQLite file instead of
# Postgres (e.g. if the Postgres host/hosting is gone). DATABASE_URL is
# ignored when this is set.
# DB_DRIVER=sqlite
# SQLITE_PATH=./data/matchcut.sqlite

# Optional: founder data-export endpoint (/api/admin/export) also POSTs
# the export JSON here if set (e.g. an S3 presigned PUT URL, a webhook).
# BACKUP_WEBHOOK_URL=
